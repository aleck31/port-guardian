# Port Guardian Configuration

accounts:
  primary:
    id: "111111111111"
    regions:
      - ap-southeast-1
      - ap-northeast-1
      - us-west-2
  secondary:
    id: "222222222222"
    role_arn: "arn:aws:iam::222222222222:role/port-guardian-target-role"
    regions:
      - ap-southeast-1
      - ap-northeast-1
      - us-west-2

cognito:
  region: ap-southeast-1
  user_pool_id: ap-southeast-1_XXXXXXXXX
  client_id: xxxxxxxxxxxxxxxxxxxxxxxxx

# SG management is driven by this tag. Its VALUE carries the ports per SG,
# e.g. `port-guardian=22,8443`. Add/remove ports or unmanage a SG by editing the tag.
target_tag:
  key: port-guardian

# Fallback ports only for a legacy bare tag value (`enabled`/empty). New SGs
# should always set explicit ports in the tag value instead.
target_ports:
  - 22
  - 3389

# FIFO eviction threshold (MAX_ENTRIES env) and MaxEntries for newly created PLs.
# Keep ≤ the real PL MaxEntries — if larger, adds fail with a mismatch error.
# Note a SG rule referencing the PL costs its MaxEntries against the SG rule
# quota, so raising this eats into "rules per security group" (default 60).
max_entries: 20

# Widest block a single IP may whitelist, as a prefix length. RDAP allocations are
# often far wider (China Mobile's is ~3.5M addresses), so this clamp decides the
# real exposure: /16 = 65,536 addresses, /20 = 4,096, /24 = 256. Cloud-hosted
# clients ignore this and always get a /32.
# Narrowing costs extra entries (and eviction churn), not access — a client outside
# its block re-adds itself through the UI, which is not IP-gated.
max_prefix_len: 16

lambda:
  deploy_region: ap-southeast-1
  # CloudWatch retention for the Lambda's log group. /status logs the client IP on
  # every request, so this bounds how long that history is kept. Applied by
  # setup.py on deploy — Chalice's log_retention_in_days targets the wrong log
  # group for the REST API handler. Must be a value CloudWatch accepts
  # (1,3,5,7,14,30,60,90,...); omit to leave retention untouched.
  log_retention_days: 30
